{
	"comments": {
		"lineComment": "//",
		"blockComment": [ "/*", "*/" ]
	},
	"brackets": [
		[ "{", "}" ],
		[ "(", ")" ],
		[ "[", "]" ]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "(", "close": ")" },
		{ "open": "[", "close": "]" },
		{ "open": "\"", "close": "\"", "notIn": [ "string", "comment" ] },
		{ "open": "/*", "close": " */", "notIn": [ "string" ] }
	],
	"surroundingPairs": [
		[ "{", "}" ],
		[ "(", ")" ],
		[ "\"", "\"" ]
	],
	"indentationRules": {
		"increaseIndentPattern": "^.*\\{[^}\"']*$",
		"decreaseIndentPattern": "^\\s*\\}"
	},
	"wordPattern": "[A-Za-z_\\u0080-\\uFFFF][A-Za-z0-9_\\u0080-\\uFFFF]*|-?\\d+(\\.\\d+)?"
}
