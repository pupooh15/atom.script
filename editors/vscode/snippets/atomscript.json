{
	"スクリプトの先頭": {
		"prefix": "script",
		"body": [ "script \"${1:folder/name}\"", "", "$0" ],
		"description": "スクリプトID（セーブデータのキー。一度決めたら変えない）"
	},
	"イベント": {
		"prefix": "event",
		"body": [ "event ${1:OnStart}(${2}) {", "\t$0", "}" ],
		"description": "イベント（ゲームや fire から起動される）"
	},
	"関数": {
		"prefix": "fn",
		"body": [ "fn ${1:Name}(${2}) {", "\t$0", "}" ],
		"description": "関数"
	},
	"スクリプト変数": {
		"prefix": "var",
		"body": [ "var ${1:name}: ${2|int,bool,float,string|} = ${3:0}" ],
		"description": "このファイルだけで使う変数（セーブ対象）"
	},
	"if": {
		"prefix": "if",
		"body": [ "if (${1:cond}) {", "\t$0", "}" ]
	},
	"if else": {
		"prefix": "ifelse",
		"body": [ "if (${1:cond}) {", "\t$2", "} else {", "\t$0", "}" ]
	},
	"switch": {
		"prefix": "switch",
		"body": [ "switch (${1:value}) {", "case ${2:0} {", "\t$3", "}", "default {", "\t$0", "}", "}" ]
	},
	"loop（break で抜ける）": {
		"prefix": "loop",
		"body": [ "loop {", "\t$0", "}" ],
		"description": "待機も break もない loop はエラーになる"
	},
	"loop（回数指定）": {
		"prefix": "loopn",
		"body": [ "loop (${1:3}) {", "\t$0", "}" ]
	},
	"parallel": {
		"prefix": "parallel",
		"body": [ "parallel {", "\tbranch { $1 }", "\tbranch { $2 }", "}", "$0" ],
		"description": "すべての branch が終わるまで待つ"
	},
	"race": {
		"prefix": "race",
		"body": [ "race {", "\tbranch { $1 }", "\tbranch { $2 }", "}", "$0" ],
		"description": "どれかの branch が終わったら、残りを中断する"
	}
}
